import * as z from "zod/v4";
import fs from "node:fs/promises";

import {
  trelloRequest,
  findOrderCard,
  findList,
  getBoardLists
} from "../trello-api.mjs";

const ARCHIVE_FILE = new URL(
  "../archive-history.json",
  import.meta.url
);

async function readArchiveHistory() {
  try {
    const data = await fs.readFile(ARCHIVE_FILE, "utf8");
    return JSON.parse(data);
  } catch {
    return {};
  }
}

async function writeArchiveHistory(history) {
  await fs.writeFile(
    ARCHIVE_FILE,
    JSON.stringify(history, null, 2),
    "utf8"
  );
}

function errorResult(error) {
  return {
    isError: true,
    content: [
      {
        type: "text",
        text:
          error instanceof Error
            ? error.message
            : String(error)
      }
    ]
  };
}

export function registerOrderTools(server) {
  // ==================================================
  // 1. FIND ORDER
  // ==================================================

  server.registerTool(
    "find-order",
    {
      description:
        "Find a Trello order by order number and show its card, board, list, archive status, and URL.",

      inputSchema: z.object({
        orderNumber: z.string()
      })
    },

    async ({ orderNumber }) => {
      try {
        const card = await findOrderCard(orderNumber);

        const [board, list] = await Promise.all([
          trelloRequest(`/boards/${card.idBoard}?fields=name`),
          trelloRequest(`/lists/${card.idList}?fields=name`)
        ]);

        return {
          content: [
            {
              type: "text",
              text:
                `Order: ${orderNumber}\n` +
                `Card: ${card.name}\n` +
                `Board: ${board.name}\n` +
                `List: ${list.name}\n` +
                `Archived: ${card.closed ? "Yes" : "No"}\n` +
                `URL: ${card.url}`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 2. MOVE ORDER
  // ==================================================

  server.registerTool(
    "move-order",
    {
      description:
        "Move an order card to another list on the same Trello board.",

      inputSchema: z.object({
        orderNumber: z.string(),
        destinationList: z.string()
      })
    },

    async ({ orderNumber, destinationList }) => {
      try {
        const card = await findOrderCard(orderNumber);

        if (card.closed) {
          throw new Error(
            `Order ${orderNumber} is archived and cannot be moved.`
          );
        }

        const currentList = await trelloRequest(
          `/lists/${card.idList}?fields=name`
        );

        const destination = await findList(
          card.idBoard,
          destinationList
        );

        if (destination.id === card.idList) {
          return {
            content: [
              {
                type: "text",
                text:
                  `Order ${orderNumber} is already in ` +
                  `${destination.name}.`
              }
            ]
          };
        }

        await trelloRequest(
          `/cards/${card.id}?idList=${encodeURIComponent(
            destination.id
          )}`,
          {
            method: "PUT"
          }
        );

        return {
          content: [
            {
              type: "text",
              text:
                `Order ${orderNumber} moved successfully.\n` +
                `Card: ${card.name}\n` +
                `From: ${currentList.name}\n` +
                `To: ${destination.name}`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 3. ARCHIVE ORDER
  // ==================================================

  server.registerTool(
    "archive-order",
    {
      description:
        "Archive an order and remember its current list so it can be restored later.",

      inputSchema: z.object({
        orderNumber: z.string()
      })
    },

    async ({ orderNumber }) => {
      try {
        const card = await findOrderCard(orderNumber);

        if (card.closed) {
          return {
            content: [
              {
                type: "text",
                text: `Order ${orderNumber} is already archived.`
              }
            ]
          };
        }

        const [board, list] = await Promise.all([
          trelloRequest(`/boards/${card.idBoard}?fields=name`),
          trelloRequest(`/lists/${card.idList}?fields=name`)
        ]);

        const history = await readArchiveHistory();

        history[orderNumber] = {
          cardId: card.id,
          cardName: card.name,
          boardId: card.idBoard,
          boardName: board.name,
          listId: card.idList,
          listName: list.name,
          archivedAt: new Date().toISOString()
        };

        await writeArchiveHistory(history);

        await trelloRequest(
          `/cards/${card.id}?closed=true`,
          {
            method: "PUT"
          }
        );

        return {
          content: [
            {
              type: "text",
              text:
                `Order ${orderNumber} archived successfully.\n` +
                `Card: ${card.name}\n` +
                `Previous List: ${list.name}\n` +
                `Original location saved.`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 4. UNARCHIVE ORDER
  // ==================================================

  server.registerTool(
    "unarchive-order",
    {
      description:
        "Restore an archived order to its previous list or another specified list.",

      inputSchema: z.object({
        orderNumber: z.string(),
        destinationList: z.string().optional()
      })
    },

    async ({ orderNumber, destinationList }) => {
      try {
        const history = await readArchiveHistory();
        const saved = history[orderNumber];

        if (!saved) {
          throw new Error(
            `No archive history found for order ${orderNumber}.`
          );
        }

        let targetListId = saved.listId;
        let targetListName = saved.listName;

        if (destinationList) {
          const target = await findList(
            saved.boardId,
            destinationList
          );

          targetListId = target.id;
          targetListName = target.name;
        } else {
          const original = await trelloRequest(
            `/lists/${saved.listId}?fields=name,closed`
          );

          if (original.closed) {
            throw new Error(
              `Original list "${saved.listName}" is archived. ` +
              `Specify another destination list.`
            );
          }
        }

        await trelloRequest(
          `/cards/${saved.cardId}` +
            `?closed=false` +
            `&idList=${encodeURIComponent(targetListId)}`,
          {
            method: "PUT"
          }
        );

        delete history[orderNumber];
        await writeArchiveHistory(history);

        return {
          content: [
            {
              type: "text",
              text:
                `Order ${orderNumber} restored successfully.\n` +
                `Card: ${saved.cardName}\n` +
                `Restored To: ${targetListName}`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 5. LIST ORDERS
  // ==================================================

  server.registerTool(
    "list-orders",
    {
      description:
        "Show all active Trello cards in a specified list on a specified board.",

      inputSchema: z.object({
        boardName: z.string(),
        listName: z.string()
      })
    },

    async ({ boardName, listName }) => {
      try {
        const boards = await trelloRequest(
          `/members/me/boards?filter=open&fields=name`
        );

        const boardMatches = boards.filter(
          (board) =>
            board.name.trim().toLowerCase() ===
            boardName.trim().toLowerCase()
        );

        if (boardMatches.length !== 1) {
          throw new Error(
            `Could not uniquely find board "${boardName}".`
          );
        }

        const board = boardMatches[0];
        const list = await findList(board.id, listName);

        const cards = await trelloRequest(
          `/lists/${list.id}/cards?filter=open&fields=name,url`
        );

        if (!cards.length) {
          return {
            content: [
              {
                type: "text",
                text:
                  `${board.name} / ${list.name}\n` +
                  `No active cards found.`
              }
            ]
          };
        }

        const cardLines = cards.map(
          (card, index) =>
            `${index + 1}. ${card.name}\n${card.url}`
        );

        return {
          content: [
            {
              type: "text",
              text:
                `${board.name} / ${list.name}\n\n` +
                `${cardLines.join("\n\n")}\n\n` +
                `Total: ${cards.length}`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 6. CREATE ORDER
  // ==================================================

  server.registerTool(
    "create-order",
    {
      description:
        "Create a new Trello order card in a specified board and list.",

      inputSchema: z.object({
        orderNumber: z.string(),
        name: z.string(),
        boardName: z.string(),
        listName: z.string()
      })
    },

    async ({
      orderNumber,
      name,
      boardName,
      listName
    }) => {
      try {
        const boards = await trelloRequest(
          `/members/me/boards?filter=open&fields=name`
        );

        const boardMatches = boards.filter(
          (board) =>
            board.name.trim().toLowerCase() ===
            boardName.trim().toLowerCase()
        );

        if (boardMatches.length !== 1) {
          throw new Error(
            `Could not uniquely find board "${boardName}".`
          );
        }

        const board = boardMatches[0];
        const list = await findList(board.id, listName);

        // Make sure the order doesn't already exist.
        try {
          const existing = await findOrderCard(orderNumber);

          if (existing) {
            throw new Error(
              `Order ${orderNumber} already exists as "${existing.name}".`
            );
          }
        } catch (error) {
          if (
            error instanceof Error &&
            !error.message.startsWith("No Trello card found")
          ) {
            throw error;
          }
        }

        const cardName =
          `${orderNumber} / ${name}`.trim();

        const newCard = await trelloRequest(
          `/cards` +
            `?idList=${encodeURIComponent(list.id)}` +
            `&name=${encodeURIComponent(cardName)}`,
          {
            method: "POST"
          }
        );

        return {
          content: [
            {
              type: "text",
              text:
                `Order created successfully.\n` +
                `Order: ${orderNumber}\n` +
                `Card: ${newCard.name}\n` +
                `Board: ${board.name}\n` +
                `List: ${list.name}\n` +
                `URL: ${newCard.url}`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 7. RENAME ORDER
  // ==================================================

  server.registerTool(
    "rename-order",
    {
      description:
        "Rename an order card while keeping the order number at the beginning of the card name.",

      inputSchema: z.object({
        orderNumber: z.string(),
        newName: z.string()
      })
    },

    async ({ orderNumber, newName }) => {
      try {
        const card = await findOrderCard(orderNumber);

        const updatedName =
          `${orderNumber} / ${newName}`.trim();

        const updated = await trelloRequest(
          `/cards/${card.id}` +
            `?name=${encodeURIComponent(updatedName)}`,
          {
            method: "PUT"
          }
        );

        return {
          content: [
            {
              type: "text",
              text:
                `Order renamed successfully.\n` +
                `Old Name: ${card.name}\n` +
                `New Name: ${updated.name}`
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );

  // ==================================================
  // 8. LIST LISTS
  // ==================================================

  server.registerTool(
    "list-lists",
    {
      description:
        "Show all active lists on a Trello board.",

      inputSchema: z.object({
        boardName: z.string()
      })
    },

    async ({ boardName }) => {
      try {
        const boards = await trelloRequest(
          `/members/me/boards?filter=open&fields=name`
        );

        const matches = boards.filter(
          (board) =>
            board.name.trim().toLowerCase() ===
            boardName.trim().toLowerCase()
        );

        if (matches.length !== 1) {
          throw new Error(
            `Could not uniquely find board "${boardName}".`
          );
        }

        const board = matches[0];
        const lists = await getBoardLists(board.id);

        const lines = lists.map(
          (list, index) =>
            `${index + 1}. ${list.name}`
        );

        return {
          content: [
            {
              type: "text",
              text:
                `Board: ${board.name}\n\n` +
                lines.join("\n")
            }
          ]
        };
      } catch (error) {
        return errorResult(error);
      }
    }
  );
}